    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Spectra uses Bluetooth to connect to your Cardputer and to scan for nearby Bluetooth devices."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectra использует Bluetooth, чтобы подключаться к Cardputer и сканировать устройства поблизости."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Spectra uses the camera to read QR codes and check the links in them. Nothing is recorded."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spectra использует камеру, чтобы читать QR-коды и проверять ссылки в них. Ничего не записывается."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Face ID locks Spectra and your assistant summaries from other people. The check stays in iOS; the app never receives it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID закрывает Spectra и сводки ассистента от посторонних. Проверка остаётся в iOS, приложение её не получает."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Spectra scans the local network to find devices, their MAC addresses and open ports."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectra сканирует локальную сеть, чтобы найти устройства, их MAC-адреса и открытые порты."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectra uses your location to read the name of the joined Wi-Fi and to mark saved scans on the map."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Геопозиция нужна Spectra, чтобы узнать имя вашей сети Wi-Fi и отметить сохранённые сканирования на карте."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
