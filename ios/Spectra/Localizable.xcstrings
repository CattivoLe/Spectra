                }
              }
            }
          }
        }
      }
    },
    "%lld devices": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройств: %lld"
          }
        }
      }
    },
    "%lld devices need attention": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройств требуют внимания: %lld"
          }
        }
      }
    },
    "%lld devices · %lld new": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройств: %1$lld · новых: %2$lld"
          }
        }
      }
    },
    "%lld frames · %@": {
      "comment": "A count of the number of frames captured and the size of the captured data.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld frames · %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадров: %lld · %@"
          }
        }
      }
    },
    "%lld in last scan": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В последнем скане: %lld"
          }
        }
      }
    },
    "%lld min": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld мин"
          }
        }
      }
