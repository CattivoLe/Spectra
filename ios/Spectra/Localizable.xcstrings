    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ (secondary above)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (дополнительный канал выше)"
          }
        }
      }
    },
    "%@ (secondary below)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (дополнительный канал ниже)"
          }
        }
      }
    },
    "%@ Answering without the internet.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ответ без интернета."
          }
        }
      }
    },
    "%@ accepted a connection without a password. Anyone on the Wi-Fi can read them.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: подключение без пароля принято. Содержимое может прочитать любой в этой Wi-Fi."
          }
        }
      }
    },
    "%@ and %lld more": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ и ещё %2$lld"
          }
        }
      }
    },
    "%@ belongs to %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ belongs to %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — официальный адрес (%2$@)."
          }
        }
      }
    },
    "%@ is %@. One probe per hop; a hop that does not answer shows as an asterisk.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — это %2$@. По одному пакету на хоп; не ответивший хоп показан звёздочкой."
          }
        }
      }
    },
    "%@ is moving data continuously — a camera or microphone may be streaming.": {
      "comment": "A description of a network that is being used by a streaming device.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ непрерывно передаёт данные — возможно, идёт трансляция с камеры или микрофона."
          }
        }
      }
    },
    "%@ is obsolete and can be broken in minutes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ устарел, его можно взломать за минуты."
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ из %@"
          }
        }
      }
    },
    "%@ · %@": {
      "comment": "A footer that shows the source of the history entry and the date it was saved.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
