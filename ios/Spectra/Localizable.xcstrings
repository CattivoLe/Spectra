{
  "sourceLanguage": "en",
  "strings": {
    "%.0f bit/s": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%.0f бит/с"
          }
        }
      }
    },
    "%.0f kbit/s": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%.0f кбит/с"
          }
        }
      }
    },
    "%.1f Mbit/s": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f Мбит/с"
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ (secondary above)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (дополнительный канал выше)"
          }
        }
      }
    },
    "%@ (secondary below)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (дополнительный канал ниже)"
          }
        }
      }
    },
    "%@ accepted a connection without a password. Anyone on the Wi-Fi can read them.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: подключение без пароля принято. Содержимое может прочитать любой в этой Wi-Fi."
          }
        }
      }
    },
    "%@ and %lld more": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ и ещё %2$lld"
          }
        }
      }
    },
    "%@ belongs to %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ belongs to %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — официальный адрес (%2$@)."
          }
        }
      }
    },
    "%@ belongs to %@: it collects data about the app's use.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ принадлежит сервису %@: он собирает данные об использовании приложения."
          }
        }
      }
    },
    "%@ is %@. One probe per hop; a hop that does not answer shows as an asterisk.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — это %2$@. По одному пакету на узел; не ответивший узел показан звёздочкой."
          }
        }
      }
    },
    "%@ is moving data continuously — a camera or microphone may be streaming.": {
      "comment": "A description of a network that is being used by a streaming device.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ непрерывно передаёт данные — возможно, идёт трансляция с камеры или микрофона."
          }
        }
      }
    },
    "%@ is obsolete and can be broken in minutes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ устарел, его можно взломать за минуты."
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ из %@"
          }
        }
      }
    },
    "%@ · %lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld"
          }
        }
      }
    },
    "%@ · %lld ms": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld мс"
          }
        }
      }
    },
    "%@ · %lld satellites": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · спутников: %2$lld"
          }
        }
      }
    },
    "%@ ↔ %@": {
      "comment": "A callout-style text that shows two endpoints separated by a \"↔\" symbol.",
      "isCommentAutoGenerated": true,
      "shouldTranslate": false
    },
    "%@, %@": {
      "comment": "A label that describes the sensor's connection status. The argument is the string “Updated %arg”, the string “Connected”, the string “Connecting…”, the string “Looking for a Cardputer”, or the string “Tap to connect”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "%@, port %lld: not HTTP and not TLS, so its content is not read.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, порт %lld: не HTTP и не TLS, поэтому содержимое не читается."
          }
        }
      }
    },
    "%@, worst %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, худшее %@"
          }
        }
      }
    },
    "%@: %@": {
      "shouldTranslate": false
    },
    "%@: an open network with this name is here now — the device will auto‑join, and the name is easy to impersonate.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: открытая сеть с таким именем сейчас рядом — устройство подключится к ней само, а имя легко подделать."
          }
        }
      }
    },
    "%d frames on channel %d — devices are being forced off %@.": {
      "comment": "A warning about a deauth attack, or a warning about a number of deauth frames on a network. The first argument is the number of deauth frames. The second argument is the channel on which the attack occurred. The third argument is the network being attacked.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$d frames on channel %2$d — devices are being forced off %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадров на канале %2$d: %1$d — устройства принудительно отключают от %3$@."
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld B": {
      "comment": "A label showing the size of a packet. The argument is the size of the packet in bytes.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Б"
          }
        }
      }
    },
    "%lld clients": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клиентов: %lld"
          }
        }
      }
    },
