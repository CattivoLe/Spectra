        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» на %d точках доступа с %@."
          }
        }
      }
    },
    "“%@” is written in letters that only look Latin.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» написано буквами, которые только похожи на латинские."
          }
        }
      }
    },
    "“%@” mixes letters from different alphabets, a classic way to fake a familiar name.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%@» смешаны буквы разных алфавитов — классический способ подделать знакомое имя."
          }
        }
      }
    },
    "↑%@ ↓%@": {
      "comment": "A label showing the number of bytes sent and received for a network flow. The first argument is the number of bytes sent. The second argument is the number of bytes received.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "↑%1$@ ↓%2$@"
