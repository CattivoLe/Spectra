            "state": "translated",
            "value": "%lld мс"
          }
        }
      }
    },
    "%lld nearby": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld рядом"
          }
        }
      }
    },
    "%lld nearby · %lld seen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld рядом · %lld всего"
          }
        }
      }
    },
    "%lld networks, %lld%% busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld networks, %2$lld%% busy"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетей: %1$lld, занятость %2$lld%%"
          }
        }
      }
    },
    "%lld new devices on your network": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новых устройств в вашей сети: %lld"
          }
        }
      }
    },
    "%lld of %lld devices": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройств: %1$lld из %2$lld"
          }
        }
      }
    },
    "%lld packets · %@": {
      "comment": "A label that shows the number of packets and size of data exchanged in a conversation.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld packets · %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакетов: %lld · %@"
          }
        }
      }
    },
    "%lld ports answer from the internet. Anyone online can reach what is behind them.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Портов отвечает из интернета: %lld. До того, что за ними, может добраться любой в сети."
          }
        }
      }
    },
    "%lld probing": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ищут сеть"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ищут сеть"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ищет сеть"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ищут сеть"
                }
              }
            }
          }
        }
      }
    },
    "%lld rules lead from the internet to devices on this network. Each one is a door; keep only the ones you set up yourself.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил, ведущих из интернета к устройствам этой сети: %lld. Каждое — дверь; оставьте только те, что настроили сами."
          }
        }
      }
    },
    "%lld without a location": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld без места"
          }
        }
      }
    },
    "%lld · %@": {
      "comment": "A subheading that shows the number of lines in a history entry, followed by the source of the entry. The first argument is the number of lines in the history entry. The second argument is the source of the history entry.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld · %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld · %2$@"
          }
        }
      }
    },
    "%lld%%, charging": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%, заряжается"
          }
        }
      }
    },
    "(%lld of %lld requests)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "(запросов: %lld из %lld)"
          }
        }
      }
    },
    "2.4 GHz": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2,4 ГГц"
          }
        }
      }
    },
    "5 GHz": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "5 ГГц"
          }
        }
      }
    },
    "802.11 LR": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "802.11 LR"
          }
        }
      }
    },
    "3D printer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3D-принтер"
          }
        }
      }
    },
    "A bare IP address (%@) stands where a site name should be.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо имени сайта — голый IP-адрес (%@)."
          }
        }
      }
    },
    "A connection to port 443. A miss can be this network filtering the site, or the site being down.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение с портом 443. Промах может быть фильтром сети или недоступностью самого сайта."
          }
        }
      }
    },
    "A connection to port 443. A miss can be this network filtering the site, or the site being down. Tap a row to measure it again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение с портом 443. Промах может быть фильтром сети или недоступностью самого сайта. Нажмите на строку, чтобы измерить снова."
          }
        }
      }
    },
    "A database answers on the network. It should listen on localhost only unless other machines need it.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База данных отвечает по сети. Ей стоит слушать только localhost, если доступ не нужен другим машинам."
          }
        }
      }
    },
    "A developer tool is listening on the network. Such servers are not built to be reachable by others.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сети слушает инструмент разработчика. Такие серверы не рассчитаны на доступ посторонних."
          }
        }
      }
    },
    "A few seconds of traffic to Cloudflare. It is a snapshot, not a full test.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько секунд трафика до Cloudflare. Это снимок, а не полный тест."
          }
        }
      }
    },
    "A name lookup (DNS): the phone asks for a server's address.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск имени (DNS): телефон узнаёт адрес сервера."
          }
        }
      }
    },
    "A network that moves data the whole time may be carrying a camera or microphone feed. Open it below to see which devices are connected.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеть, по которой постоянно идут данные, может передавать поток с камеры или микрофона. Откройте её ниже, чтобы увидеть подключённые устройства."
          }
        }
      }
    },
    "A personal answer may be kept by any cache on the way (Cache-Control: public).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личный ответ разрешено хранить любому кэшу по пути (Cache-Control: public)."
          }
        }
      }
    },
    "A phone behind a router usually does not answer pings from the internet. A reply means the public address answered.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон за роутером обычно не отвечает на пинги из интернета. Ответ значит, что публичный адрес ответил."
          }
        }
      }
    },
    "A phone behind a router usually does not answer pings from the internet. A reply means the public address answered. Tap a row to ask that server again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон за роутером обычно не отвечает на пинги из интернета. Ответ значит, что отозвался публичный адрес. Нажмите на строку, чтобы спросить этот сервер ещё раз."
          }
        }
      }
    },
    "A phone cannot tell a tag in your bag from one in the bag next to you. Only its staying with you as you move does.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон не отличит метку в вашей сумке от метки в соседней. Отличает только то, остаётся ли она с вами при перемещении."
          }
        }
      }
    },
    "A server administration panel. Keep it updated and behind a strong password.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель администрирования сервера. Обновляйте её и защитите надёжным паролем."
          }
        }
      }
    },
    "A short link: the real address is hidden. Expand the redirects to see it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткая ссылка: настоящий адрес скрыт. Раскройте переадресации, чтобы его увидеть."
          }
        }
      }
    },
    "A tag away from its owner has stayed near you for a while. Move somewhere else and check whether it is still here.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метка без владельца уже некоторое время рядом с вами. Перейдите в другое место и проверьте, осталась ли она здесь."
          }
        }
      }
    },
    "a WebSocket message": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "сообщение WebSocket"
          }
        }
      }
    },
    "About this endpoint": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Об этом эндпоинте"
          }
        }
      }
    },
    "access token": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "токен доступа"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
