    "Web search": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск в интернете"
          }
        }
      }
    },
    "Web search is allowed: the query text goes out, and you can see it in the log. With page reading on, the phone also opens the pages found, as a browser does. Besides this, the internet is used to download models.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск в интернете разрешён: наружу уходит текст запроса, и вы видите его в журнале. Если включено чтение страниц, телефон ещё и открывает найденные страницы, как браузер. Кроме этого, интернет нужен для скачивания моделей."
          }
        }
      }
    },
    "Webmin": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Webmin"
          }
        }
      }
