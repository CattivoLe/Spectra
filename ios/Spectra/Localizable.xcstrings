          }
        }
      }
    },
    "Edit the path if the camera needs one (e.g. /cam, /live).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Допишите путь, если он нужен камере (например, /cam, /live)."
