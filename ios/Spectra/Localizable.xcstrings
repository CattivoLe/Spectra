      "isCommentAutoGenerated": true
    },
    "Stop watching": {
      "comment": "A button that stops watching a device.",
      "isCommentAutoGenerated": true
    },
    "Stopped after 10 redirects.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено после 10 переадресаций."
          }
        }
      }
    },
    "Stopped: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
