    "Devices connected to this network, found through promiscuous-mode frame capture on the sensor.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства, подключённые к этой сети. Найдены через захват фреймов в эфире на сенсоре."
          }
        }
      }
    },
    "Devices sending probe requests nearby, revealing networks they have connected to before.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства поблизости, рассылающие probe-запросы. Видны сети, к которым они подключались ранее."
          }
        }
      }
    },
    "Disconnect": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить"
          }
        }
      }
    },
    "Discovering devices…": {
      "comment": "Scanning progress phase when using TCP port discovery.",
      "isCommentAutoGenerated": true
    },
    "Each hump is one network: its width is the channels it covers, its height how loud it is here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый холм — одна сеть: ширина показывает, какие каналы она занимает, высота — насколько громко она слышна здесь."
          }
        }
      }
    },
