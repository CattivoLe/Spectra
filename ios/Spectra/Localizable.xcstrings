    "“%@” is distributed under this license. The download starts at once and continues even if you close the app.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» распространяется на условиях этой лицензии. Скачивание начнётся сразу и продолжится, даже если вы закроете приложение."
          }
        }
      }
    },
    "“%@” is on %d access points with %@.": {
      "comment": "A possible evil twin. The first argument is the SSID. The second argument is the number of access points. The third argument is the value of the localized string key ““%@” is on %d access points with %@.”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@” is on %2$d access points with %3$@."
          }
