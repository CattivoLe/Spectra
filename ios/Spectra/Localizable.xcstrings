    },
    "%lld packets · %@": {
      "comment": "A label that shows the number of packets and size of data exchanged in a conversation.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld packets · %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld пакетов · %@"
          }
        }
      }
    },
    "%lld ports answer from the internet. Anyone online can reach what is behind them.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Портов отвечает из интернета: %lld. До того, что за ними, может добраться любой в сети."
          }
        }
      }
    },
    "%lld probing": {
      "localizations": {
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ищут сеть"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ищут сеть"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ищет сеть"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ищут сеть"
                }
              }
            }
          }
        }
      }
    },
    "%lld rules lead from the internet to devices on this network. Each one is a door; keep only the ones you set up yourself.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правил, ведущих из интернета к устройствам этой сети: %lld. Каждое — дверь; оставьте только те, что настроили сами."
          }
        }
      }
    },
    "%lld without a location": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld без места"
          }
        }
      }
    },
    "%lld · %@": {
      "comment": "A subheading that shows the number of lines in a history entry, followed by the source of the entry. The first argument is the number of lines in the history entry. The second argument is the source of the history entry.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld · %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld · %2$@"
          }
        }
      }
    },
    "%lld%% charging": {
      "comment": "A battery level. The argument is the string “Updated %arg”, the string “Connected”, the string “Connecting…”, the string “Looking for a Cardputer”, or the string “Tap to connect”.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%, заряжается"
          }
        }
      }
    },
