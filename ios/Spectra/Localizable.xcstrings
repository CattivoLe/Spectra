      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить запись"
          }
        }
      }
    },
    "Stop watching": {
      "comment": "A button that stops watching a device.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не отслеживать"
          }
        }
      }
    },
    "Stopped after 10 redirects.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено после 10 переадресаций."
          }
        }
      }
    },
    "Stopped: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено: %@"
          }
        }
      }
    },
    "Stops at %@": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрывается на %@"
          }
        }
      }
    },
    "Stream address": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес потока"
          }
        }
      }
    },
    "Streams": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потоки"
          }
        }
      }
    },
    "Supported": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживается"
          }
        }
      }
    },
    "Suspicious": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подозрительное"
          }
        }
      }
    },
    "Suspicious link": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подозрительная ссылка"
          }
        }
      }
    },
    "Switch": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключатель"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система"
          }
        }
      }
    },
    "T-Bank": {
      "comment": "Brand or agency name",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Т-Банк"
          }
        }
      }
    },
    "The bookmark keeps a web page in Web interfaces on the LAN tab.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закладка сохраняет веб-страницу в «Веб-интерфейсы» на вкладке LAN."
          }
        }
      }
    },
    "the path": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "путь"
          }
        }
      }
    },
    "the request body": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "тело запроса"
          }
        }
      }
    },
    "the request itself is wrong": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "запрос составлен неверно"
          }
        }
      }
    },
    "the request took too long to arrive": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "запрос шёл слишком долго"
          }
        }
      }
    },
    "The same request went out %lld times within %lld s: repeats nobody needed, or a retry loop.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один и тот же запрос: отправок %lld за %lld с. Лишние повторы или зацикленные попытки."
          }
        }
      }
    },
    "the server did not accept it": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "сервер его не принял"
          }
        }
      }
    },
    "The server failed: status %lld.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ответил ошибкой: статус %lld."
          }
        }
      }
    },
    "there is nothing at this address": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "по этому адресу ничего нет"
          }
        }
      }
    },
    "These requests are no longer in the list.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этих запросов больше нет в списке."
          }
        }
      }
    },
    "TKIP is enabled for old devices and weakens the whole network.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включён TKIP для старых устройств, он ослабляет защиту всей сети."
          }
        }
      }
    },
    "TLS": {
      "comment": "Label for the TLS field in the flow detail view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS"
          }
        }
      }
    },
    "TR-069 remote management": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённое управление TR-069"
          }
        }
      }
    },
    "Trace the path to %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проследить путь до %@"
          }
        }
      }
    },
    "traffic capture": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "запись трафика"
          }
        }
      }
    },
    "TX power": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мощность передатчика"
          }
        }
      }
    },
    "Tap a host or a conversation to show only its packets.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на узел или разговор, чтобы показать только его пакеты."
          }
        }
      }
    },
    "Tap a site to check it, hold to remove. Asked over HTTPS without loading the page.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на сайт, чтобы проверить, удерживайте, чтобы убрать. Запрос идёт по HTTPS без загрузки страницы."
          }
        }
      }
    },
    "Tap to connect": {
      "comment": "A label displayed when the sensor is not connected.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключить"
          }
        }
      }
    },
    "Tap to scan": {
      "comment": "Text displayed in the LAN status bar when the user has not yet scanned for a network.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать скан"
          }
        }
      }
    },
    "Target": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель"
          }
        }
      }
    },
    "Targeted deauth": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направленный deauth"
          }
        }
      }
    },
    "Telnet": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Telnet"
          }
        }
      }
    },
    "Telnet on a router is how most router botnets got in. Turn it off in the router's settings.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через Telnet на роутере попадало большинство роутерных ботнетов. Выключите его в настройках роутера."
          }
        }
      }
    },
    "Telnet, open shares, remote access and the like. Tap to show only those.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Telnet, открытые папки, удалённый доступ и подобное. Нажмите, чтобы показать только их."
          }
        }
      }
    },
    "Test again": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить тест"
          }
        }
      }
    },
    "Test the connection": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить соединение"
          }
        }
      }
    },
    "That capture is too large to open on the phone (over 80 MB).": {
      "comment": "Error message when a user tries to open a pcap file that is too large to open on the phone.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот захват слишком велик, чтобы открыть его на телефоне (больше 80 МБ)."
          }
        }
      }
    },
    "That is not a site name or an IP address.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не имя сайта и не IP-адрес."
          }
        }
      }
    },
    "That is not a site name, or it is already in the list.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не имя сайта, или он уже есть в списке."
          }
        }
      }
    },
    "That password is not valid for this network.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пароль не подходит для этой сети."
          }
        }
      }
    },
    "That photo could not be read.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это фото не удалось прочитать."
          }
        }
      }
    },
    "The .%@ registry does not publish registration dates.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реестр зоны .%@ не публикует даты регистрации."
          }
        }
      }
    },
    "The .%@ zone is common in phishing mail.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зона .%@ часто встречается в фишинговых письмах."
          }
        }
      }
    },
    "The Cardputer reboots when the transfer finishes. Keep it powered and nearby.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardputer перезагрузится в конце передачи. Не выключайте его и держите рядом."
          }
        }
      }
    },
    "The Cardputer's Cap LoRa-1262 listens on EU868 and RU864 channels. A side-button save keeps the list and the GPS fix for when the phone reconnects.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap LoRa-1262 на Cardputer слушает каналы EU868 и RU864. Боковая кнопка сохраняет список и координаты GPS — они приедут, когда телефон снова подключится."
          }
        }
      }
    },
    "The LED blinks red for a threat, yellow for a warning, orange for a tracker that keeps showing up, green for an open network, blue for a watched Bluetooth device and purple for a watched network.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светодиод мигает красным при угрозе, жёлтым при предупреждении, оранжевым при трекере, который появляется скан за сканом, зелёным при открытой сети, синим при отслеживаемом Bluetooth-устройстве и фиолетовым при отслеживаемой сети."
          }
        }
      }
    },
    "The Mac can be controlled from the network. Fine if you set it up; otherwise turn off Remote Management.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этим Mac можно управлять по сети. Нормально, если вы это настроили; иначе выключите «Удалённое управление»."
          }
        }
      }
    },
    "The VPN is bypassed: the check measures the Wi-Fi or Ethernet connection itself.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN обходится: проверяется само подключение по Wi‑Fi или Ethernet."
          }
        }
      }
    },
    "The address has words phishing likes to use: %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В адресе слова, которые любят фишеры: %@."
          }
        }
      }
    },
    "The address starts with %@, but the site belongs to %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The address starts with %1$@, but the site belongs to %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес начинается с %1$@, но на самом деле это сайт %2$@."
          }
        }
      }
    },
    "The address the lookups come from is learned by resolving whoami.akamai.net; ipwho.is names its owner. Encrypted DNS is tried against Cloudflare over HTTPS and over TLS on port 853.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес, с которого уходят запросы, узнаётся разрешением whoami.akamai.net; ipwho.is называет его владельца. Шифрованный DNS проверяется на Cloudflare через HTTPS и через TLS на порту 853."
          }
        }
      }
    },
    "The address uses an unusual port, %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В адресе необычный порт: %@."
          }
        }
      }
    },
    "The app carries the firmware.bin from its last build. Rebuild the iOS app after pio run and the new version shows up here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение содержит firmware.bin из своей последней сборки. Пересоберите iOS-приложение после pio run — и здесь появится новая версия."
          }
        }
      }
    },
    "The browser skips everything before the @ (%@) and opens %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The browser skips everything before the @ (%1$@) and opens %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё до знака @ (%1$@) браузер пропустит и откроет %2$@."
          }
        }
      }
    },
    "The camera's stream is reachable from the Wi-Fi. Many cameras ship with a default password; change it.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поток камеры доступен из Wi-Fi. Многие камеры продаются с заводским паролем — смените его."
          }
        }
      }
    },
    "The certificate expired on %@.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок сертификата истёк %@."
          }
        }
      }
    },
    "The certificate was issued %lld days ago. Phishing sites are usually only days old.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификат выдан %lld дн. назад. Фишинговым сайтам обычно всего несколько дней."
          }
        }
      }
    },
    "The certificate was issued to %@, not to this site.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификат выдан для %@, а не для этого сайта."
          }
        }
      }
    },
    "The certificate was issued today. Phishing sites are usually only days old.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификат выдан сегодня. Фишинговым сайтам обычно всего несколько дней."
          }
        }
      }
    },
    "The certificate's fingerprint. Compare it with the one another network or device sees: a different value for the same site means someone in between re-signs the traffic.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпечаток сертификата. Сравните его с тем, что видно из другой сети или с другого устройства: другое значение для того же сайта значит, что кто-то посередине переподписывает трафик."
          }
        }
      }
    },
    "The chart fills in as the test runs.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "График заполняется по ходу теста."
          }
        }
      }
    },
    "The check contacts Cloudflare, ipwho.is and check-host.net. They see your public IP address.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка обращается к Cloudflare, ipwho.is и check-host.net. Они видят ваш внешний IP-адрес."
          }
        }
      }
    },
    "The check goes out through the mobile network, even while Wi-Fi is joined. It uses mobile data.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка идёт через сотовую сеть, даже когда подключён Wi-Fi. Расходуется мобильный трафик."
          }
        }
      }
    },
    "The check reads the address only, on this iPhone, and does not open the site. No warnings is not a guarantee: a new phishing site can have a plain-looking address.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка смотрит только на адрес, идёт на этом iPhone и не открывает сайт. Отсутствие предупреждений — не гарантия: у нового фишингового сайта может быть вполне обычный адрес."
          }
        }
      }
    },
    "The checksum does not match: the file was damaged in download. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрольная сумма не совпала — файл скачался с повреждениями. Попробуйте ещё раз."
          }
        }
      }
    },
    "The device closed the connection. What it gave is kept below.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство разорвало соединение. Прочитанное осталось ниже."
          }
        }
      }
    },
    "The domain has existed since %@, %lld years.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Домен существует с %1$@, уже %2$lld г."
          }
        }
      }
    },
    "The domain is only %lld days old, registered on %@.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Домену всего %1$lld дн., зарегистрирован %2$@."
          }
        }
      }
    },
    "The domain was registered %lld days ago, on %@.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Домен зарегистрирован %1$lld дн. назад, %2$@."
          }
        }
      }
    },
    "The domain was registered on %@.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Домен зарегистрирован %@."
          }
        }
      }
    },
    "The domain was registered today.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Домен зарегистрирован сегодня."
          }
        }
      }
    },
    "The encryption key in the keychain is damaged.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ шифрования в связке ключей повреждён."
          }
        }
      }
    },
    "The file parsed, but it holds no packets.": {
      "comment": "A message displayed when a pcap file is empty.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл прочитан, но пакетов в нём нет."
          }
        }
      }
    },
    "The firmware inside the app is for %@, and this sensor is %@. Pick its own firmware.bin from Files, or flash it over USB.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошивка внутри приложения — для %@, а этот сенсор — %@. Выберите его собственный firmware.bin в «Файлах» или прошейте по USB."
          }
        }
      }
    },
    "The gateway answers, but nothing past it does.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шлюз отвечает, а дальше сеть не пускает."
          }
        }
      }
    },
    "The graph fills in as advertisements arrive.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "График заполнится, когда придут объявления."
          }
        }
      }
    },
    "The graph fills in as scans come in": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "График заполнится по мере сканирования"
          }
        }
      }
    },
    "The image failed its checksum. Transfer it again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрольная сумма образа не сошлась. Передайте его ещё раз."
          }
        }
      }
    },
    "The internet is used only to download models, and only when you tap Download.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Интернет нужен только для скачивания моделей, и только когда вы нажимаете «Скачать»."
          }
        }
      }
    },
    "The internet works, but services that are often blocked do not open.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Интернет работает, но часто блокируемые сервисы не открываются."
          }
        }
      }
    },
    "The label follows the device by these, even when its address changes.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метка следует за устройством по этим признакам, даже если адрес изменится."
          }
        }
      }
    },
    "The last redirect leaves the web for a %@: link.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя переадресация уводит из веба на ссылку %@:."
          }
        }
      }
    },
    "The link passes on another address: %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка передаёт дальше другой адрес: %@."
          }
        }
      }
    },
    "The link to the sensor dropped.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связь с сенсором оборвалась."
          }
        }
      }
    },
    "The list holds the first %lld packets. The summary above counts all %lld.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В списке первые %lld пакетов. Сводка выше учитывает все %lld."
          }
        }
      }
    },
    "The lock covers the whole of Spectra. If your face is not recognized, the phone's passcode opens it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка закрывает всё приложение Spectra. Если лицо не распознаётся, оно откроется кодом-паролем телефона."
          }
        }
      }
    },
    "The lookup service is busy. Try again in a minute.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба проверки занята. Повторите через минуту."
          }
        }
      }
    },
    "The model gets only the short snippets from the results: faster, but they often lack exact numbers.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель получает только короткие описания из выдачи: быстрее, но точных цифр в них часто нет."
          }
        }
      }
    },
    "The model is already answering another request": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель уже отвечает на другой запрос"
          }
        }
      }
    },
    "The network has no password: traffic on it can be read by anyone nearby.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У сети нет пароля: трафик в ней может прочитать любой поблизости."
          }
        }
      }
    },
    "The network is hidden, which is unusual for a public one.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеть скрытая, что необычно для публичной."
          }
        }
      }
    },
    "The next scan of this network becomes the baseline: nothing in it is marked New.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующее сканирование этой сети станет точкой отсчёта: в нём ничего не будет помечено как новое."
          }
        }
      }
    },
    "The page is not encrypted (http): anything typed on it can be read on the way.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница без шифрования (http): всё, что на ней вводится, можно прочитать по пути."
          }
        }
      }
    },
    "The path from this phone to any site or address, hop by hop, on a map.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Путь от телефона до любого сайта или адреса, узел за узлом, на карте."
          }
        }
      }
    },
    "The phone asks a public resolver directly.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон спрашивает публичный резолвер напрямую."
          }
        }
      }
    },
    "The phone downloads the top pages, takes their main text and gives the model only the parts that fit the question. That finds exact numbers and dates, but the answer starts a few seconds later, and the sites see the phone's address, as when you open a page.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон скачивает первые страницы выдачи, берёт из них основной текст и отдаёт модели только куски, относящиеся к вопросу. Так находятся точные цифры и даты, но ответ начинается на несколько секунд позже, а сайты видят адрес телефона, как при обычном открытии страницы."
          }
        }
      }
    },
    "The port an internet provider uses to manage routers. Flaws in it have let worms in; it should not answer on the Wi-Fi.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порт, через который провайдер управляет роутерами. Через его уязвимости проникали черви; в Wi-Fi он отвечать не должен."
          }
        }
      }
    },
    "The prompt (%lld tokens) does not fit the context (%lld)": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промпт (%lld токенов) не помещается в контекст (%lld)"
          }
        }
      }
    },
    "The registry could not be reached: %@.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реестр недоступен: %@."
          }
        }
      }
    },
    "The registry has no record of %@. The name may be free, or the link may be a decoy.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В реестре нет записи о %@. Имя может быть свободно, либо ссылка — приманка."
          }
        }
      }
    },
    "The registry lists %@ but gives no registration date.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реестр знает %@, но не сообщает дату регистрации."
          }
        }
      }
    },
    "The router does not answer UPnP requests, so its forwardings cannot be listed from here.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Роутер не отвечает на запросы UPnP, поэтому его пробросы отсюда не прочитать."
          }
        }
      }
    },
    "The router forwards %@ from the internet to this device. Anyone online can try those ports, not just people on the Wi-Fi.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Роутер пробрасывает %@ из интернета на это устройство. Эти порты может проверить любой в интернете, а не только те, кто в Wi-Fi."
          }
        }
      }
    },
    "The router takes the lookups and forwards them: the world sees them come from the resolver above.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Роутер принимает запросы и пересылает их: мир видит их от резолвера выше."
          }
        }
      }
    },
    "The router's password crosses the Wi-Fi in the clear when you log in. Use the https address if the router offers one.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При входе пароль роутера идёт по Wi-Fi открытым текстом. Используйте адрес https, если роутер его предлагает."
          }
        }
      }
    },
    "The search server address is invalid.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный адрес сервера поиска."
          }
        }
      }
    },
    "The search server answered with error %lld.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер поиска ответил ошибкой %lld."
          }
        }
      }
    },
    "The search server returned an unreadable answer.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер поиска вернул непонятный ответ."
          }
        }
      }
    },
    "The search service sees your query and IP address, as with any search. If that matters, use your own SearXNG server.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поисковый сервис видит ваш запрос и IP-адрес, как при обычном поиске. Если это важно, используйте свой сервер SearXNG."
          }
        }
      }
    },
    "The sensor could not finish the update.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сенсор не смог завершить обновление."
          }
        }
      }
    },
    "The sensor could not start the update. Flash it once over USB so the OTA slots exist, then try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сенсор не смог начать обновление. Один раз прошейте его по USB, чтобы появились слоты OTA, и повторите."
          }
        }
      }
    },
    "The sensor could not write the image.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сенсор не смог записать образ."
          }
        }
      }
    },
    "The sensor is not connected.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сенсор не подключён."
          }
        }
      }
    },
    "The sensor is still scanning. Wait for the sweep to finish and try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сенсор ещё сканирует. Дождитесь конца прохода и повторите."
          }
        }
      }
    },
    "The sensor lost its place in the image.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сенсор потерял место в образе."
          }
        }
      }
    },
    "The sensor rebooted, but the app could not reconnect. It is looking for the Cardputer again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сенсор перезагрузился, но приложение не смогло подключиться снова. Оно снова ищет Cardputer."
          }
        }
      }
    },
    "The sensor rejected the image header.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сенсор отклонил заголовок образа."
          }
        }
      }
    },
    "The server answered with error %lld.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ответил ошибкой %lld."
          }
        }
      }
    },
    "The server answers, but found nothing.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер отвечает, но ничего не нашёл."
          }
        }
      }
    },
    "The site answered with error %lld.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт ответил ошибкой %lld."
          }
        }
      }
    },
    "The site could not be reached to read its certificate.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с сайтом, чтобы прочитать сертификат."
          }
        }
      }
    },
    "The site name contains encoded characters, which real sites do not use.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В имени сайта закодированные символы — настоящие сайты так не делают."
          }
        }
      }
    },
    "The site name uses non-Latin letters.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя сайта написано не латиницей."
          }
        }
      }
    },
    "The site sits on %@, where anyone can make an address like this.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт размещён на %@ — такой адрес может завести кто угодно."
          }
        }
      }
    },
    "The speed server did not answer.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер замера скорости не ответил."
          }
        }
      }
    },
    "The system interrupted the download.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка прервана системой."
          }
        }
      }
    },
    "The update timed out. Keep the Cardputer close and try again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время обновления вышло. Держите Cardputer рядом и повторите."
          }
        }
      }
    },
    "There is no mobile network to check.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сотовой сети для проверки."
          }
        }
      }
    },
    "There is no network connection to check.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сети, которую можно проверить."
          }
        }
      }
    },
    "There is no network for the chosen connection.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сети для выбранного соединения."
          }
        }
      }
    },
    "They cannot be restored.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить их будет нельзя."
          }
        }
      }
    },
    "This address is on a local network: such pages are never opened.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес в локальной сети: такие страницы не открываются."
          }
        }
      }
    },
    "This build of the app has no firmware inside. Run pio run before building the app, or pick firmware.bin from Files.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой сборке приложения нет прошивки. Выполните pio run перед сборкой приложения или выберите firmware.bin в «Файлах»."
          }
        }
      }
    },
    "This check was saved before certificate details were kept. Run the connection check again to see them.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта проверка сохранена до того, как приложение стало хранить подробности сертификата. Запустите проверку соединения снова, чтобы их увидеть."
          }
        }
      }
    },
    "This code joins a Wi-Fi network named “%@”.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код подключает к Wi-Fi-сети «%@»."
          }
        }
      }
    },
    "This device": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство"
          }
        }
      }
    },
    "This device has no Bluetooth Low Energy.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве нет Bluetooth Low Energy."
          }
        }
      }
    },
    "This device would not send the trace probes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство не дало отправить пакеты трассировки."
          }
        }
      }
    },
    "This file is too short to be a capture.": {
      "comment": "Error message when a pcap file is too short to be a capture.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл слишком короткий для захвата."
          }
        }
      }
    },
    "This firmware cannot take updates from the app. Flash 0.6.0 or newer once over USB or the launcher; after that, updates install from here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта прошивка не принимает обновления из приложения. Один раз поставьте 0.6.0 или новее по USB или через лаунчер — дальше их можно ставить отсюда."
          }
        }
      }
    },
    "This firmware speaks protocol %lld; the app expects %lld. Update the one that is older.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This firmware speaks protocol %1$lld; the app expects %2$lld. Update the one that is older."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошивка использует протокол %1$lld, а приложение ждёт %2$lld. Обновите то, что старее."
          }
        }
      }
    },
    "This iPhone": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот iPhone"
          }
        }
      }
    },
    "This image does not fit in the sensor's update slot.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образ не помещается в слот обновления сенсора."
          }
        }
      }
    },
    "This is not a model file: GGUF format expected.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не файл модели: ожидается формат GGUF."
          }
        }
      }
    },
    "This is not a pcap or pcapng file.": {
      "comment": "Error message when the file is not a pcap or pcapng file.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не файл pcap или pcapng."
          }
        }
      }
    },
    "This is not a web link but a %@: link.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не веб-ссылка, а ссылка %@:."
          }
        }
      }
    },
    "This is not a web page (%@).": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не веб-страница (%@)."
          }
        }
      }
    },
    "This is not a web page: a %@: link runs code or opens a file.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не веб-страница: ссылка %@: запускает код или открывает файл."
          }
        }
      }
    },
    "This is not an ESP32 application image. Choose firmware.bin from pio run, not a merged flash image.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не образ приложения ESP32. Нужен firmware.bin от pio run, а не слитый образ прошивки."
          }
        }
      }
    },
    "This network has no password. Anyone nearby can join it and read traffic that is not encrypted.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой сети нет пароля. Любой поблизости может подключиться и читать незашифрованный трафик."
          }
        }
      }
    },
    "This network is on 5 GHz (channel %lld), and this sensor hears only 2.4 GHz. Capturing it needs the ESP32-C5 sensor.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сеть в диапазоне 5 ГГц (канал %lld), а этот сенсор слышит только 2,4 ГГц. Для захвата нужен сенсор ESP32-C5."
          }
        }
      }
    },
    "This network is on 5 GHz (channel %lld). The sensor's firmware %@ captures on 2.4 GHz only: update the sensor to firmware %@ or newer.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сеть в диапазоне 5 ГГц (канал %lld). Прошивка сенсора %@ захватывает только на 2,4 ГГц: обновите сенсор до прошивки %@ или новее."
          }
        }
      }
    },
    "This network is open. iOS will ask you to confirm before joining.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеть открытая. iOS попросит подтвердить подключение."
          }
        }
      }
    },
    "This network resolves names itself: the lookups leave from your own public address.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сеть разрешает имена сама: запросы уходят с вашего публичного адреса."
          }
        }
      }
    },
    "This phone blocked the probes a traceroute needs.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон не дал отправить пакеты, нужные для трассировки."
          }
        }
      }
    },
    "This phone will be tight on memory: crashes are possible": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этому телефону будет тесно: возможны вылеты"
          }
        }
      }
    },
    "This recording": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта запись"
          }
        }
      }
    },
    "This tag has lost its owner and has stayed within range of you. Move to another place and come back to this screen: if it is still here, look for it with Find.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта метка потеряла владельца и остаётся в радиусе слышимости рядом с вами. Перейдите в другое место и вернитесь на этот экран: если она всё ещё здесь, поищите её через «Найти»."
          }
        }
      }
    },
    "This Wi-Fi gives the iPhone no IPv4 address. The device scan walks an IPv4 subnet, so there is nothing to sweep here. Connection, speed and link checks on the Internet tab work as usual.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сеть Wi-Fi не выдала iPhone адрес IPv4. Поиск устройств перебирает IPv4-подсеть, поэтому здесь ему нечего сканировать. Проверка соединения, скорости и ссылок на вкладке «Интернет» работает как обычно."
          }
        }
      }
    },
    "Threats": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Угрозы"
          }
        }
      }
    },
    "Through VPN": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через VPN"
          }
        }
      }
    },
    "Through a VPN the public address belongs to the VPN server, so its ports say nothing about your router.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через VPN публичный адрес принадлежит серверу VPN, поэтому его порты ничего не говорят о вашем роутере."
          }
        }
      }
    },
    "Throughput is the steady part of each transfer, after the first second of ramp-up.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорость — установившаяся часть каждой передачи, после первой секунды разгона."
          }
        }
      }
    },
    "Tile, Samsung SmartTag, Chipolo and Find My Device tags report their position through other people's phones. One near its owner is just someone's keys.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метки Tile, Samsung SmartTag, Chipolo и сети Find My Device сообщают своё положение через чужие телефоны. Метка рядом с владельцем — это просто чьи-то ключи."
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время"
          }
        }
      }
