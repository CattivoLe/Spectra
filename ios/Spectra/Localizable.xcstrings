    "%@ · for search by meaning": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · для поиска по смыслу"
          }
        }
      }
    },
    "%@ ↔ %@": {
      "comment": "A callout-style text that shows two endpoints separated by a \"↔\" symbol.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ ↔ %2$@"
          }
        }
      }
    },
    "%@, %@": {
      "comment": "A label that describes the sensor's connection status. The argument is the string “Updated %arg”, the string “Connected”, the string “Connecting…”, the string “Looking for a Cardputer”, or the string “Tap to connect”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "%@: an open network with this name is here now — the device will auto‑join, and the name is easy to impersonate.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: открытая сеть с таким именем сейчас рядом — устройство подключится к ней само, а имя легко подделать."
          }
        }
      }
    },
    "%d frames on channel %d — devices are being forced off %@.": {
      "comment": "A warning about a deauth attack, or a warning about a number of deauth frames on a network. The first argument is the number of deauth frames. The second argument is the channel on which the attack occurred. The third argument is the network being attacked.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$d frames on channel %2$d — devices are being forced off %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%d кадров на канале %d — устройства принудительно отключают от %@."
          }
        }
      }
    },
    "%lld": {
      "localizations": {
