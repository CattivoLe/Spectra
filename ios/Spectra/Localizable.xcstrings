    "Connection": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение"
          }
        }
      }
    },
    "connection check": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "проверка соединения"
          }
        }
      }
    },
    "Connection checks are saved here automatically, by network.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверки соединения сохраняются здесь автоматически, по сетям."
          }
        }
      }
    },
    "Connects to the device to list its services and read the values it exposes. Many devices allow only a brief connection. Short codes are standard Bluetooth ones; long UUIDs belong to the maker, who rarely publishes what they mean, so only the raw bytes can be shown.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключается к устройству, показывает его сервисы и читает значения, которые оно отдаёт. Многие устройства разрешают лишь кратковременное подключение. Короткие коды — стандартные для Bluetooth; длинные UUID придумал производитель, и он редко публикует их смысл, поэтому видны только сырые байты."
          }
        }
      }
    },
    "Continue": {
      "comment": "A button that continues a message when pressed.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить"
          }
        }
      }
    },
    "Conversations": {
      "comment": "A heading for a list of conversations in a PCAP file.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пары адресов"
          }
        }
      }
    },
    "Cookies set with weak protection: %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куки заданы со слабой защитой: %@."
