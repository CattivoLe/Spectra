    "Only sites from the provider's allow-list open. The rest of the internet does not answer.": {
      "extractionState": "stale",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открываются только сайты из белого списка оператора. Остальной интернет не отвечает."
          }
