        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не для разговора: помогает поиску в интернете находить на страницах нужные куски по смыслу, а не только по совпадению слов. В наших пробах нашла ответ во всех 16 случаях против 14 у поиска по словам. Нужен включённый поиск в интернете."
          }
        }
      }
