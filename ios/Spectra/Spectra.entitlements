<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app join the phone itself to a Wi-Fi network with
	     NEHotspotConfiguration. Free capability: enable "Hotspot Configuration"
	     on the target in Xcode (Signing & Capabilities); no request to Apple. -->
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
	<!-- Lets NEHotspotNetwork.fetchCurrent name the network the phone is on,
	     including ones Spectra did not configure, so the list can mark it.
	     Free capability: "Access Wi-Fi Information". -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<!-- Packet-tunnel sniffer: lets the app host the SpectraTunnel extension.
	     PAID capability — enable "Network Extensions" on the App ID. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- The assistant loads a multi-gigabyte language model on the phone; without this
	     the system kills the app at the default memory limit. Capability: "Increased
	     Memory Limit" (free, enable it on the target in Xcode). -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Shares captured flows / the local CA between app and extension. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.cattivole.Spectra</string>
	</array>
</dict>
</plist>
